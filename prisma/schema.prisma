// Prisma schema — CRM RH multi-clients (Phase 1)
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Rôles applicatifs. String plutôt que Prisma enum pour rester compatible SQLite <-> Postgres.
// Valeurs valides : "ADMIN_CABINET" | "CONSULTANT" | "CLIENT"
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  nom       String
  role      String   @default("CONSULTANT")
  createdAt DateTime @default(now())

  clientAccess UserClientAccess[]
}

model ClientCompany {
  id        String   @id @default(cuid())
  nom       String
  secteur   String?
  adresse   String?
  contactNom   String?
  contactEmail String?
  effectif  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAccess    UserClientAccess[]
  jobFamilies   JobFamily[]
  positions     Position[]
  employees     Employee[]
}

model UserClientAccess {
  id              String        @id @default(cuid())
  userId          String
  clientCompanyId String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientCompany   ClientCompany @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)

  @@unique([userId, clientCompanyId])
}

model JobFamily {
  id              String        @id @default(cuid())
  clientCompanyId String
  nom             String
  description     String?
  clientCompany   ClientCompany @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  positions       Position[]

  createdAt DateTime @default(now())
}

model Position {
  id                   String        @id @default(cuid())
  clientCompanyId      String
  jobFamilyId          String?
  titre                String
  niveau               String?
  reportingPositionId  String?

  clientCompany   ClientCompany @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  jobFamily       JobFamily?    @relation(fields: [jobFamilyId], references: [id])
  reportsTo       Position?     @relation("PositionHierarchy", fields: [reportingPositionId], references: [id])
  subordinates    Position[]    @relation("PositionHierarchy")

  employees       Employee[]
  jobDescriptions JobDescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id              String   @id @default(cuid())
  clientCompanyId String
  positionId      String?
  managerId       String?
  nom             String
  prenom          String
  email           String?
  dateEmbauche    DateTime?

  clientCompany ClientCompany @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  position      Position?     @relation(fields: [positionId], references: [id])
  manager       Employee?     @relation("EmployeeHierarchy", fields: [managerId], references: [id])
  reports       Employee[]    @relation("EmployeeHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// statut : "BROUILLON" | "VALIDE"
model JobDescription {
  id          String   @id @default(cuid())
  positionId  String
  missions    String
  competences String
  statut      String   @default("BROUILLON")
  version     Int      @default(1)

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
